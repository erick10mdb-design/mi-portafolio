---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="5. CV | Portafolio de evidencias"
  description="Currículum académico y profesional de Erick Noe Flores Ramirez."
>
  <section class="cv-hero">
    <div class="container cv-hero-content">
      <span class="hero-label">✦ PERFIL PROFESIONAL</span>
      <h1>5.CV</h1>
      <p>Conocimientos, habilidades y experiencias que construyen mi camino en la Ingeniería Informática.</p>
      <div class="hero-line"></div>
    </div>
    <div class="hero-decoration"></div>
  </section>

  <section class="cv-main">
    <div class="container cv-layout">

      <!-- TARJETA DE PERFIL -->
      <aside class="profile-card">
        <div class="profile-cover">
          <span>ESTUDIANTE · 5.º SEMESTRE</span>
        </div>

        <div class="profile-content">
          <img
            src="/images/mi-foto.jpg"
            alt="Fotografía de Erick Noe Flores Ramirez"
            class="profile-photo"
          />

          <h2>Erick Noe Flores Ramirez</h2>
          <p class="profile-role">Estudiante de Ingeniería Informática</p>

          <div class="profile-divider"></div>

          <div class="profile-highlight">
            <span class="highlight-icon">⌘</span>
            <div>
              <strong>Área de interés</strong>
              <p>Desarrollo de software y tecnología</p>
            </div>
          </div>

          <div class="profile-tags">
            <span>Desarrollo web</span>
            <span>Programación</span>
            <span>Bases de datos</span>
          </div>

          <a href="#contacto" class="contact-button">
            Contactar conmigo <span>↗</span>
          </a>
        </div>
      </aside>

      <!-- CONTENIDO DEL CV -->
      <div class="cv-content">

        <section class="cv-section">
          <div class="section-heading">
            <span class="section-icon">01</span>
            <div>
              <h2>Perfil profesional</h2>
              <p>Quién soy y hacia dónde voy</p>
            </div>
          </div>

          <p class="profile-description">
            Soy estudiante de Ingeniería Informática, interesado en el desarrollo
            de soluciones mediante programación, aplicaciones web, sistemas
            embebidos y bases de datos. He trabajado en prácticas que combinan
            software y hardware, interfaces web, comunicación entre dispositivos
            y configuración de redes. Busco seguir fortaleciendo mis habilidades
            técnicas, aprender de manera constante y colaborar responsablemente
            en proyectos académicos y profesionales.
          </p>
        </section>

        <section class="cv-section">
          <div class="section-heading">
            <span class="section-icon">02</span>
            <div>
              <h2>Formación académica</h2>
              <p>Mi preparación profesional</p>
            </div>
          </div>

          <div class="education-card">
            <div class="education-marker">🎓</div>
            <div>
              <span class="education-status">FORMACIÓN ACTUAL</span>
              <h3>Ingeniería Informática</h3>
              <p class="school-name">
                Tecnológico de Estudios Superiores de San Felipe del Progreso
              </p>
              <div class="education-footer">
                <span>📚 5.º semestre</span>
                <span>Educación superior</span>
              </div>
            </div>
          </div>
        </section>

        <section class="cv-section">
          <div class="section-heading">
            <span class="section-icon">03</span>
            <div>
              <h2>Conocimientos técnicos</h2>
              <p>Tecnologías y herramientas que he trabajado</p>
            </div>
          </div>

          <div class="skills-grid">
            <article class="skill-card">
              <div class="skill-icon">🌐</div>
              <h3>Desarrollo web</h3>
              <p>Astro, HTML, CSS, Tailwind CSS y consumo de APIs.</p>
              <span class="skill-label">Frontend</span>
            </article>

            <article class="skill-card">
              <div class="skill-icon">💻</div>
              <h3>Programación</h3>
              <p>Python, lógica de programación e interfaces con Tkinter.</p>
              <span class="skill-label">Software</span>
            </article>

            <article class="skill-card">
              <div class="skill-icon">🗄️</div>
              <h3>Backend y datos</h3>
              <p>FastAPI, SQL, MySQL y manejo de bases de datos.</p>
              <span class="skill-label">Datos</span>
            </article>

            <article class="skill-card">
              <div class="skill-icon">⚡</div>
              <h3>Hardware</h3>
              <p>ESP32, Arduino, sensores y lector RFID MFRC522.</p>
              <span class="skill-label">Sistemas embebidos</span>
            </article>

            <article class="skill-card">
              <div class="skill-icon">🔗</div>
              <h3>Redes</h3>
              <p>Direccionamiento IP, routers y pruebas de conectividad.</p>
              <span class="skill-label">Conectividad</span>
            </article>

            <article class="skill-card">
              <div class="skill-icon">🛠️</div>
              <h3>Herramientas</h3>
              <p>Visual Studio Code, XAMPP y entornos de desarrollo.</p>
              <span class="skill-label">Desarrollo</span>
            </article>
          </div>
        </section>

        <section class="cv-section">
          <div class="section-heading">
            <span class="section-icon">04</span>
            <div>
              <h2>Habilidades personales</h2>
              <p>Competencias para trabajar y aprender</p>
            </div>
          </div>

          <div class="personal-skills">
            <span>✓ Resolución de problemas</span>
            <span>✓ Organización</span>
            <span>✓ Creatividad</span>
            <span>✓ Aprendizaje continuo</span>
            <span>✓ Documentación de procesos</span>
            <span>✓ Colaboración en equipo</span>
          </div>
        </section>

        <section class="cv-section contact-section" id="contacto">
          <div class="section-heading">
            <span class="section-icon">05</span>
            <div>
              <h2>Contacto</h2>
              <p>Información para comunicarse conmigo</p>
            </div>
          </div>

          <div class="contact-grid">
            <a class="contact-card" href="mailto:erick14res@gmail.com">
              <span class="contact-icon">✉</span>
              <div>
                <small>CORREO ELECTRÓNICO</small>
                <strong>erick14res@gmail.com</strong>
              </div>
              <span class="contact-arrow">↗</span>
            </a>

            <a class="contact-card" href="tel:5592317473">
              <span class="contact-icon">☎</span>
              <div>
                <small>TELÉFONO</small>
                <strong>5592317473</strong>
              </div>
              <span class="contact-arrow">↗</span>
            </a>
          </div>
        </section>

        <div class="cv-footer">
          <span>◆</span>
          <p>Aprender, innovar y construir soluciones con tecnología.</p>
        </div>

      </div>
    </div>
  </section>

  <style>
    .cv-hero {
      position: relative;
      overflow: hidden;
      color: #fff;
      background: linear-gradient(125deg, #091a30 0%, #123c63 60%, #1769aa 100%);
      padding: 66px 0 76px;
    }

    .cv-hero-content {
      position: relative;
      z-index: 1;
    }

    .hero-label {
      display: inline-block;
      padding: 8px 14px;
      border: 1px solid #75bfff66;
      border-radius: 30px;
      background: #ffffff0c;
      color: #a9dcff;
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 2px;
    }

    .cv-hero h1 {
      margin: 20px 0 12px;
      font-size: clamp(2.4rem, 5vw, 4rem);
      line-height: 1.1;
      letter-spacing: -2px;
      font-weight: 800;
    }

    .cv-hero h1 span {
      color: #72c4ff;
    }

    .cv-hero p {
      max-width: 650px;
      color: #d0e3f5;
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .hero-line {
      width: 74px;
      height: 5px;
      margin-top: 24px;
      border-radius: 10px;
      background: #59b8fa;
    }

    .hero-decoration {
      position: absolute;
      right: -90px;
      bottom: -240px;
      width: 430px;
      height: 430px;
      border: 65px solid #ffffff09;
      border-radius: 50%;
      pointer-events: none;
    }

    .cv-main {
      padding: 48px 0 76px;
      background: #f2f6fb;
    }

    .cv-layout {
      display: grid;
      grid-template-columns: 290px minmax(0, 1fr);
      gap: 28px;
      align-items: start;
    }

    .profile-card {
      overflow: hidden;
      position: sticky;
      top: 100px;
      background: #fff;
      border: 1px solid #e0e8f2;
      border-radius: 22px;
      box-shadow: 0 15px 40px #193b5b0d;
    }

    .profile-cover {
      height: 105px;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 17px;
      background: linear-gradient(130deg, #10243a, #1769aa);
    }

    .profile-cover span {
      padding: 6px 10px;
      border: 1px solid #ffffff35;
      border-radius: 30px;
      color: #e0f2ff;
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .profile-content {
      padding: 0 23px 24px;
      text-align: center;
    }

    .profile-photo {
      display: block;
      width: 124px;
      height: 124px;
      margin: -58px auto 17px;
      position: relative;
      object-fit: cover;
      object-position: center;
      border: 5px solid #fff;
      border-radius: 50%;
      background: #e4effa;
      box-shadow: 0 5px 18px #10243a20;
    }

    .profile-content h2 {
      margin: 0;
      color: #10243a;
      font-size: 1.28rem;
      line-height: 1.35;
    }

    .profile-role {
      margin: 8px 0 0;
      color: #64768b;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .profile-divider {
      height: 1px;
      margin: 22px 0;
      background: #e9eff5;
    }

    .profile-highlight {
      display: flex;
      align-items: center;
      gap: 12px;
      text-align: left;
    }

    .highlight-icon {
      display: grid;
      flex-shrink: 0;
      place-items: center;
      width: 43px;
      height: 43px;
      border-radius: 13px;
      background: #e5f3ff;
      color: #1769aa;
      font-size: 1.4rem;
    }

    .profile-highlight strong {
      color: #183650;
      font-size: 0.88rem;
    }

    .profile-highlight p {
      margin: 3px 0 0;
      color: #738297;
      font-size: 0.78rem;
    }

    .profile-tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 7px;
      margin: 20px 0;
    }

    .profile-tags span {
      padding: 6px 10px;
      border-radius: 30px;
      background: #edf6ff;
      color: #17609c;
      font-size: 0.73rem;
      font-weight: 700;
    }

    .contact-button {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 12px;
      border-radius: 11px;
      background: #1769aa;
      color: #fff;
      font-size: 0.88rem;
      font-weight: 700;
      transition: background 0.2s, transform 0.2s;
    }

    .contact-button:hover {
      transform: translateY(-2px);
      background: #105487;
    }

    .cv-content {
      min-width: 0;
    }

    .cv-section {
      margin-bottom: 23px;
      padding: 27px;
      border: 1px solid #e0e8f2;
      border-radius: 19px;
      background: #fff;
      box-shadow: 0 8px 24px #193b5b08;
      scroll-margin-top: 100px;
    }

    .section-heading {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 21px;
    }

    .section-icon {
      display: grid;
      flex-shrink: 0;
      place-items: center;
      width: 47px;
      height: 47px;
      border-radius: 14px;
      background: linear-gradient(135deg, #e5f3ff, #d6eaff);
      color: #1769aa;
      font-size: 0.92rem;
      font-weight: 800;
    }

    .section-heading h2 {
      margin: 0;
      color: #10243a;
      font-size: 1.35rem;
      letter-spacing: -0.5px;
    }

    .section-heading p {
      margin: 3px 0 0;
      color: #8290a2;
      font-size: 0.82rem;
    }

    .profile-description {
      margin: 0;
      color: #53667b;
      font-size: 0.95rem;
      line-height: 1.9;
    }

    .education-card {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 20px;
      border: 1px solid #dfebf7;
      border-radius: 15px;
      background: linear-gradient(120deg, #f6fbff, #fff);
    }

    .education-marker {
      display: grid;
      flex-shrink: 0;
      place-items: center;
      width: 49px;
      height: 49px;
      border-radius: 14px;
      background: #e3f2ff;
      font-size: 1.35rem;
    }

    .education-status {
      color: #1769aa;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 1.3px;
    }

    .education-card h3 {
      margin: 5px 0 6px;
      color: #153752;
      font-size: 1.1rem;
    }

    .school-name {
      margin: 0;
      color: #64768b;
      font-size: 0.9rem;
      line-height: 1.7;
    }

    .education-footer {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 14px;
    }

    .education-footer span {
      padding: 5px 9px;
      border-radius: 7px;
      background: #eaf4fd;
      color: #275e8b;
      font-size: 0.73rem;
      font-weight: 700;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 13px;
    }

    .skill-card {
      padding: 18px;
      border: 1px solid #e4ebf3;
      border-radius: 15px;
      background: #fff;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }

    .skill-card:hover {
      transform: translateY(-4px);
      border-color: #a8d5fa;
      box-shadow: 0 12px 25px #1769aa12;
    }

    .skill-icon {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      margin-bottom: 12px;
      border-radius: 12px;
      background: #edf6ff;
      font-size: 1.2rem;
    }

    .skill-card h3 {
      margin: 0 0 7px;
      color: #183650;
      font-size: 0.98rem;
    }

    .skill-card p {
      min-height: 62px;
      margin: 0;
      color: #6a7b8f;
      font-size: 0.83rem;
      line-height: 1.7;
    }

    .skill-label {
      display: inline-block;
      margin-top: 13px;
      padding: 5px 8px;
      border-radius: 6px;
      background: #f0f6fc;
      color: #376a96;
      font-size: 0.68rem;
      font-weight: 800;
    }

    .personal-skills {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .personal-skills span {
      padding: 10px 13px;
      border: 1px solid #dcebf8;
      border-radius: 10px;
      background: #f5faff;
      color: #315674;
      font-size: 0.82rem;
      font-weight: 600;
    }

    .contact-grid {
      display: grid;
      gap: 12px;
    }

    .contact-card {
      display: flex;
      align-items: center;
      gap: 13px;
      min-width: 0;
      padding: 15px;
      border: 1px solid #e1eaf4;
      border-radius: 13px;
      background: #fbfdff;
      transition: border-color 0.2s, background 0.2s;
    }

    .contact-card:hover {
      border-color: #8dc8f5;
      background: #f2f9ff;
    }

    .contact-icon {
      display: grid;
      flex-shrink: 0;
      place-items: center;
      width: 43px;
      height: 43px;
      border-radius: 12px;
      background: #e5f3ff;
      color: #1769aa;
      font-size: 1.25rem;
    }

    .contact-card div {
      min-width: 0;
      flex: 1;
    }

    .contact-card small {
      display: block;
      margin-bottom: 4px;
      color: #8190a2;
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.7px;
    }

    .contact-card strong {
      overflow-wrap: anywhere;
      color: #24435e;
      font-size: 0.88rem;
    }

    .contact-arrow {
      color: #1769aa;
      font-weight: 800;
    }

    .cv-footer {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 13px;
      color: #71849a;
      text-align: center;
      font-size: 0.82rem;
    }

    .cv-footer span {
      color: #1769aa;
    }

    .cv-footer p {
      margin: 0;
    }

    @media (max-width: 850px) {
      .cv-layout {
        grid-template-columns: 1fr;
      }

      .profile-card {
        position: static;
        max-width: 460px;
        width: 100%;
        margin: 0 auto 8px;
      }
    }

    @media (max-width: 520px) {
      .cv-hero {
        padding: 48px 0 55px;
      }

      .cv-hero h1 {
        letter-spacing: -1px;
      }

      .cv-main {
        padding: 25px 0 45px;
      }

      .cv-section {
        padding: 20px;
        border-radius: 15px;
      }

      .section-heading {
        gap: 11px;
      }

      .section-heading h2 {
        font-size: 1.13rem;
      }

      .section-icon {
        width: 41px;
        height: 41px;
      }

      .skills-grid {
        grid-template-columns: 1fr;
      }

      .skill-card p {
        min-height: 0;
      }

      .education-card {
        padding: 15px;
        gap: 11px;
      }

      .education-marker {
        width: 40px;
        height: 40px;
      }
    }
  </style>
</BaseLayout>